# Large generated data matrices (too big for git)
*.rds

# Large raw satellite data (too big for git; see *_source_location.md)
data_common/raw/ndvi/*.nc
data_common/raw/ndwi/*.nc
data_common/raw/mtbs/tif/
data_common/raw/fire_perimeters/*.gpkg
data_common/raw/forest_damage/CONUS_Region5_AllYears.gdb/
data_common/raw/lcmap/*.tif
data_common/raw/forest_damage/CONUS_Region5_AllYears.gdb.zip
data_common/raw/prism/prismz.zip
data_common/raw/prism/prismz/
data_common/raw/ecoregion/us_eco_l3/

# macOS zip artifact -- shows up in any zip created on macOS (confirmed
# present in prism/prismz.zip); catches it wherever it lands, not just
# where we've happened to notice it.
**/__MACOSX/

# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/
